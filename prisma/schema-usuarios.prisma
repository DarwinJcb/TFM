/**
 * prisma/schema-usuarios.prisma:
 */
generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma-usuarios"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Genero {
  MASCULINO
  FEMENINO
}

model Usuario {
  IdUsuario             Int                    @id @default(autoincrement())
  nombre                String
  edad                  Int
  biografia             String?
  peso                  Float?
  altura                Float?
  nacionalidad          String?
  genero                Genero
  numero                String?
  correo                String                 @unique
  contrasenaHash        String?
  signoZodiacal         String?
  queBusca              String?
  hobby                 String?
  dedicacion            String?
  fotos                 Foto[]
  ubicaciones           Ubicacion[]
  musicas               Musica[]
  condicionComunicacion CondicionComunicacion?
  estadoActividad       EstadoActividad?
  fechaCreacion         DateTime               @default(now())
  fechaActualizacion    DateTime               @updatedAt
}

model Ubicacion {
  IdUbicacion        Int      @id @default(autoincrement())
  ciudad             String
  pais               String
  descripcion        String?
  UsuarioFK          Int
  usuario            Usuario  @relation(fields: [UsuarioFK], references: [IdUsuario], onDelete: Cascade)
  fechaCreacion      DateTime @default(now())
  fechaActualizacion DateTime @updatedAt
}

model Foto {
  IdFoto        Int      @id @default(autoincrement())
  urlFoto       String
  descripcion   String?
  UsuarioFK     Int
  usuario       Usuario  @relation(fields: [UsuarioFK], references: [IdUsuario], onDelete: Cascade)
  fechaCreacion DateTime @default(now())
}

model Musica {
  IdMusica           Int      @id @default(autoincrement())
  nombreCancion      String?
  tipoMusica         String?
  UsuarioFK          Int
  usuario            Usuario  @relation(fields: [UsuarioFK], references: [IdUsuario], onDelete: Cascade)
  fechaCreacion      DateTime @default(now())
  fechaActualizacion DateTime @updatedAt
}

model CondicionComunicacion {
  IdCondicionComunicacion  Int      @id @default(autoincrement())
  permiteMensajes          Boolean  @default(true)
  requiereMatchParaChatear Boolean  @default(true)
  descripcion              String?
  UsuarioFK                Int      @unique
  usuario                  Usuario  @relation(fields: [UsuarioFK], references: [IdUsuario], onDelete: Cascade)
  fechaCreacion            DateTime @default(now())
  fechaActualizacion       DateTime @updatedAt
}

model EstadoActividad {
  IdEstadoActividad  Int       @id @default(autoincrement())
  estaActivo         Boolean   @default(false)
  enLive             Boolean   @default(false)
  ultimaConexion     DateTime?
  UsuarioFK          Int       @unique
  usuario            Usuario   @relation(fields: [UsuarioFK], references: [IdUsuario], onDelete: Cascade)
  fechaActualizacion DateTime  @updatedAt
}
