/**
 * prisma/schema-interacciones.prisma:
 */
generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma-interacciones"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum TipoInteraccion {
  LIKE
  NO_LIKE
  EVITAR
  REPORTAR
  SUPERLIKE
}

model Interaccion {
  IdInteraccion Int @id @default(autoincrement())

  tipo        TipoInteraccion
  descripcion String?

  UsuarioOrigenFK  Int
  UsuarioDestinoFK Int

  fechaCreacion DateTime @default(now())

  @@unique([UsuarioOrigenFK, UsuarioDestinoFK, tipo])
  @@index([UsuarioOrigenFK])
  @@index([UsuarioDestinoFK])
}

model Match {
  IdMatch Int @id @default(autoincrement())

  UsuarioUnoFK Int
  UsuarioDosFK Int
  activo       Boolean @default(true)

  chats Chat[]

  fechaCreacion DateTime @default(now())

  @@unique([UsuarioUnoFK, UsuarioDosFK])
  @@index([UsuarioUnoFK])
  @@index([UsuarioDosFK])
}

model Chat {
  IdChat Int @id @default(autoincrement())

  UsuarioUnoFK Int
  UsuarioDosFK Int
  MatchFK      Int? @unique

  match Match? @relation(fields: [MatchFK], references: [IdMatch], onDelete: SetNull)

  mensajes Mensaje[]

  fechaCreacion      DateTime @default(now())
  fechaActualizacion DateTime @updatedAt

  @@unique([UsuarioUnoFK, UsuarioDosFK])
  @@index([UsuarioUnoFK])
  @@index([UsuarioDosFK])
}

model Mensaje {
  IdMensaje Int @id @default(autoincrement())

  contenido String
  leido     Boolean @default(false)

  ChatFK    Int
  UsuarioFK Int

  chat Chat @relation(fields: [ChatFK], references: [IdChat], onDelete: Cascade)

  fechaCreacion DateTime @default(now())

  @@index([ChatFK])
  @@index([UsuarioFK])
}
