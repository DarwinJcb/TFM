/**
 * prisma/schema-comercial.prisma:
 */
generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma-comercial"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum TipoSuscripcion {
  BRONCE
  GOLD
  PREMIUM
  PLATINO
}

model PlanSuscripcion {
  IdPlanSuscripcion  Int             @id @default(autoincrement())
  tipo               TipoSuscripcion @unique
  valor              Decimal         @db.Decimal(10, 2)
  ventajas           String?
  contenido          String?
  mensajesIlimitados Boolean         @default(false)
  suscripciones      Suscripcion[]
  restricciones      Restriccion[]
  fechaCreacion      DateTime        @default(now())
  fechaActualizacion DateTime        @updatedAt
}

model Suscripcion {
  IdSuscripcion     Int       @id @default(autoincrement())
  UsuarioFK         Int       @unique
  PlanSuscripcionFK Int
  fechaInicio       DateTime  @default(now())
  fechaFin          DateTime?
  activa            Boolean   @default(true)

  planSuscripcion PlanSuscripcion @relation(fields: [PlanSuscripcionFK], references: [IdPlanSuscripcion], onDelete: Restrict)

  @@index([PlanSuscripcionFK])
}

model Restriccion {
  IdRestriccion     Int              @id @default(autoincrement())
  descripcion       String
  activa            Boolean          @default(true)
  PlanSuscripcionFK Int?
  planSuscripcion   PlanSuscripcion? @relation(fields: [PlanSuscripcionFK], references: [IdPlanSuscripcion], onDelete: Cascade)
  fechaCreacion     DateTime         @default(now())
  @@index([PlanSuscripcionFK])
}

model Donacion {
  IdDonacion        Int      @id @default(autoincrement())
  monto             Decimal  @db.Decimal(10, 2)
  mensaje           String?
  UsuarioDonanteFK  Int
  UsuarioReceptorFK Int
  fechaCreacion     DateTime @default(now())

  @@index([UsuarioDonanteFK])
  @@index([UsuarioReceptorFK])
}
